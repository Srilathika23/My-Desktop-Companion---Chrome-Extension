{
  "manifest_version": 3,
  "name": "Desktop Pet Web Companion",
  "version": "1.3",
  "description": "An interactive wellness companion with dynamic video states.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["companion1.mp4", "companion2.mp4"],
      "matches": ["<all_urls>"]
    }
  ]
}